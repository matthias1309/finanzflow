# FinanzFlow Docker Environment Variables
# Copy this file to .env and fill in the values

NODE_ENV=production
PORT=3000
DB_PATH=/data/finance.db
APP_ORIGIN=http://localhost:3000

# Authentication
APP_USER=admin
# Generate with: npx bcryptjs 'yourpassword'
# Then put the hash here (ESCAPE $ SIGNS WITH \)
APP_PASSWORD_HASH=\$2b\$10\$placeholder

# Session Management
# Generate with: openssl rand -hex 16
SESSION_SECRET=

# Two-Factor Authentication (TOTP)
# Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=FinanzFlow

# Optional: Session timeout (hours)
SESSION_MAX_AGE_HOURS=8
